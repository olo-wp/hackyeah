# Copy to ~/routeable/.env on the VM, chmod 600, and replace credentials.
# Quote values containing $, # or spaces with single quotes for Compose.
DATABASE_URL='postgresql://LOGIN:PASSWORD@DB_HOST:5432/routeable?sslmode=require'
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
USER_AGENT='RouteAble/0.1 (contact@routeable.net)'
WEB_PROVIDER_TIMEOUT_MS=35000
PROVIDER_CACHE_TTL_HOURS=24
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=60
GEMINI_MAX_INPUT_CHARS=60000
ORS_API_KEY=
