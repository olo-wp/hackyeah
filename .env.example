# --- Database ---------------------------------------------------------------
# External PostgreSQL 18. Replace the database user, password and database name.
# URL-encode special characters in credentials (e.g. @ becomes %40).
# Docker Compose requires this value; an empty value is only for local in-memory API runs.
DATABASE_URL=postgresql://login:password@34.158.225.184:5432/routeable

# --- OpenStreetMap providers -------------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim and Overpass require a descriptive User-Agent with contact info.
USER_AGENT=RouteAble/0.1 (hackyeah-2026; contact@example.com)

# --- Services ----------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000

# MCP server: stdio for local AI clients, http for container deployments.
MCP_TRANSPORT=stdio
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=3002

# Base URL the web app uses to reach the REST API.
ROUTEABLE_API_URL=http://localhost:3001

# --- Providers and caching ---------------------------------------------------
WEB_PROVIDER_TIMEOUT_MS=5000
PROVIDER_CACHE_TTL_HOURS=24
STALE_AFTER_DAYS=180

# Gemini classifies OSM tags and website text, and researches each place with Google Search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=60
GEMINI_MAX_INPUT_CHARS=60000

# Routing: ORS stays server-side; for local Next.js add NEXT_PUBLIC_MAPTILER_KEY
# to apps/web/.env.local. For Docker builds set it in the root .env instead.
ORS_API_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# --- API hardening -----------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT=120/minute
