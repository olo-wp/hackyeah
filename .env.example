# --- Database ---------------------------------------------------------------
# Leave empty to run the API on the in-memory evidence store (no Postgres needed).
DATABASE_URL=postgres://routeable:routeable@localhost:5432/routeable

# --- OpenStreetMap providers -------------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Nominatim and Overpass require a descriptive User-Agent with contact info.
USER_AGENT=RouteAble/0.1 (hackyeah-2026; contact@example.com)

# --- Services ----------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000

# MCP server: stdio for local AI clients, http for container deployments.
MCP_TRANSPORT=stdio
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=3002

# Base URL the web app uses to reach the REST API.
ROUTEABLE_API_URL=http://localhost:3001

# --- Providers and caching ---------------------------------------------------
WEB_PROVIDER_TIMEOUT_MS=5000
PROVIDER_CACHE_TTL_HOURS=24
STALE_AFTER_DAYS=180

# --- API hardening -----------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT=120/minute
